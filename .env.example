# Google Analytics 4 — Measurement ID from analytics.google.com (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity — Project ID from clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# Razorpay — Settings -> API Keys in the Razorpay Dashboard.
# Use TEST MODE keys (rzp_test_...) until you're ready to go live.
# KEY_SECRET is server-only — never prefix it with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Vercel Blob — Storage -> your Blob store -> .env.local tab in the Vercel Dashboard.
# Vercel injects this automatically once a Blob store is connected to the project;
# only needed manually for local dev / scripts/upload-pdf.mjs.
BLOB_READ_WRITE_TOKEN=

# Internal secret used to sign temporary PDF download tokens. Not a
# third-party credential — generate your own random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value per environment (local vs. Vercel).
PDF_ACCESS_SECRET=

# Postgres connection string for the purchases database (see README for
# setup — any standard Postgres provider works: Neon, Supabase, Vercel
# Postgres, etc). Include ?sslmode=require for hosted providers.
DATABASE_URL=

# Admin dashboard login (/admin/login). Pick your own values — these are
# not issued by any third party. ADMIN_PASSWORD is compared server-side only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the admin session cookie. A separate secret from PDF_ACCESS_SECRET
# so rotating one never invalidates the other. Generate the same way:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
